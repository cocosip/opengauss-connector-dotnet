<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>OpenGaussConnector</RootNamespace>
    <AssemblyName>OpenGaussConnector.Json.NET</AssemblyName>
    <PackageId>OpenGaussConnector.Json.NET</PackageId>
    <Description>Json.NET plugin for OpenGaussConnector, allowing transparent serialization and deserialization of JSON objects directly to and from the database.</Description>
    <PackageTags>opengauss;postgresql;json;postgres;ado;ado.net;database;sql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenGaussConnector/OpenGaussConnector.csproj" />
  </ItemGroup>

</Project>