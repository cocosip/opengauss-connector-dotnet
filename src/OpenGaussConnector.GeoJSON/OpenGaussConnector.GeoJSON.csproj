<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>OpenGaussConnector</RootNamespace>
    <AssemblyName>OpenGaussConnector.GeoJSON</AssemblyName>
    <PackageId>OpenGaussConnector.GeoJSON</PackageId>
    <Description>GeoJSON plugin for OpenGaussConnector, allowing mapping of PostGIS geometry types to GeoJSON types.</Description>
    <PackageTags>opengauss;postgresql;postgis;geojson;spatial;ado;ado.net</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GeoJSON.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenGaussConnector/OpenGaussConnector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>