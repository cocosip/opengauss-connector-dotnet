<Project>

  <PropertyGroup>
    <!--
      Single version for every package in the repository; no project declares its
      own <Version>. 0.x pre-release line, independent of the server version.
    -->
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Project-owned strong-name identity; upstream's key is not reused. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)OpenGaussConnector.snk</AssemblyOriginatorKeyFile>
    <!-- Public half of OpenGaussConnector.snk, for InternalsVisibleTo on signed assemblies. -->
    <OpenGaussConnectorPublicKey></OpenGaussConnectorPublicKey>

    <Copyright>Copyright 2026 © The OpenGaussConnector Development Team</Copyright>
    <Company>OpenGaussConnector</Company>
    <Authors>The OpenGaussConnector Development Team</Authors>
    <PackageLicenseExpression>MulanPSL2</PackageLicenseExpression>
    <PackageIcon>openGauss.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <NoWarn>$(NoWarn);NU5105</NoWarn>
  </PropertyGroup>

  <!-- In netstandard2.0 the BCL isn't annotated for nullability, so disable it there. -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)openGauss.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
